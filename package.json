{
  "name": "travelcanary",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.19.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.6.2",
  "bin": {
    "travelcanary": "bin/travelcanary"
  },
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:selfhost": "next start --hostname 127.0.0.1",
    "start:container": "next start --hostname 0.0.0.0",
    "collector": "node --import tsx scripts/collector.ts",
    "omarchy:check": "node scripts/validate-omarchy-plugin.mjs && vitest run tests/unit/omarchy-model.test.ts",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:fast": "node --import tsx scripts/check.ts --fast",
    "check:deploy": "npm run check:fast && npm run build",
    "check:audit": "npm audit --audit-level=high",
    "check:release": "node --eval \"console.error('Use scripts/verify instead of npm run check:release'); process.exit(1)\"",
    "check:full": "node --import tsx scripts/check.ts --full",
    "data:generate": "node scripts/generate-catalog.mjs && node scripts/generate-coverage.mjs",
    "data:metadata": "node scripts/update-catalog-metadata.mjs",
    "applicability:generate": "node scripts/generate-hazard-applicability.mjs",
    "chmi-orp:generate": "node scripts/generate-chmi-orp-mapping.mjs",
    "coverage:generate": "node scripts/generate-coverage.mjs",
    "mapping:it-flood": "node --import tsx scripts/generate-it-flood-mapping.ts",
    "countries:generate": "node scripts/generate-covered-countries.mjs",
    "coverage:check": "node scripts/generate-coverage.mjs --check",
    "sources:generate": "node --import tsx scripts/generate-source-inventory.ts",
    "sources:check": "node --import tsx scripts/generate-source-inventory.ts --check",
    "national-alerts:bootstrap": "node --import tsx scripts/generate-lu-alert-bootstrap.ts",
    "demo:generate": "node --import tsx scripts/generate-demo.ts",
    "conditions:demo": "node --import tsx scripts/generate-demo-conditions.ts",
    "conditions:mappings": "node --import tsx scripts/generate-conditions-mappings.ts",
    "conditions:check": "node --import tsx scripts/generate-conditions-mappings.ts --check && node scripts/generate-hazard-applicability.mjs --input data/review-inputs/gvp-holocene.json --reviewed-at 2026-08-31 --check",
    "conditions:warm": "node --import tsx scripts/warm-conditions.ts",
    "state:project-v10": "node --import tsx scripts/project-state-v10.ts",
    "state:project-v11": "node --import tsx scripts/project-state-v11.ts",
    "smoke:conditions": "node --import tsx scripts/smoke-conditions.ts",
    "data:validate": "node --import tsx scripts/validate-data.ts",
    "storage:init": "node --import tsx scripts/init-storage.ts",
    "smoke:sources": "node --import tsx scripts/smoke-sources.ts",
    "verify:production": "node --import tsx scripts/verify-production.ts",
    "perf:assets": "node scripts/check-asset-budget.mjs",
    "perf:bench": "node --import tsx scripts/benchmark-risk.ts",
    "smoke:warning-expansion": "node --import tsx scripts/smoke-warning-expansion.ts",
    "coverage:measure": "node --import tsx scripts/coverage-history.ts",
    "catalog:check": "node --import tsx scripts/generate-catalog-v3.ts --check && node scripts/generate-covered-countries.mjs --catalog 3 --check && node --import tsx scripts/generate-demo-v3.ts --check",
    "check:catalog3": "node --eval \"console.error('Use scripts/verify instead of npm run check:catalog3'); process.exit(1)\""
  },
  "dependencies": {
    "@turf/boolean-intersects": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@vercel/blob": "2.8.0",
    "fast-xml-parser": "5.11.0",
    "geotiff": "3.0.5",
    "maplibre-gl": "6.6.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
