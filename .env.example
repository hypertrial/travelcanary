# Local self-hosting. The legacy TRAVELCANARY_DATA_DIR remains accepted only
# as a migration parent; new installations should use three explicit roots.
TRAVELCANARY_RUNTIME=local
TRAVELCANARY_PRIVATE_DATA_DIR=/var/lib/travelcanary/private
TRAVELCANARY_PUBLIC_DATA_DIR=/var/lib/travelcanary/public
TRAVELCANARY_CACHE_DIR=/var/cache/travelcanary
LOCAL_CONDITIONS_ENABLED=true

# Vercel Production only. Preview and Development ignore these values and use
# the checked-in demo publication. Generate CRON_SECRET from at least 32 random
# bytes and keep every value server-only.
CRON_SECRET=
PRIVATE_INGESTION_BLOB_READ_WRITE_TOKEN=
PUBLIC_SNAPSHOT_BLOB_READ_WRITE_TOKEN=
TRAVELCANARY_PUBLICATION_URL=
# Required only when this repository is deployed as a wrapper submodule. Use
# the wrapper's exact 40-character commit SHA; direct deployments omit it.
TRAVELCANARY_RELEASE_SHA=

# Optional collector feature gates. Credential-gated warning transports remain
# dormant and request-free when their separately documented credentials are absent.
INGESTION_PAUSED=false
INGESTION_DISABLED_SOURCES=
NATIONAL_ALERTS_DISABLED_COUNTRIES=
NATIONAL_ALERTS_DISABLED_TRANSPORTS=
GFM_ENABLED=true
GLOFAS_TARGETING_ENABLED=true
EFFIS_PERIMETERS_ENABLED=true
IFRC_FALLBACK_ENABLED=true
GDELT_ENABLED=false
CONTEXT_FEEDS_ENABLED=true
