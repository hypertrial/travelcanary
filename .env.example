# Browser data source. Use demo locally; production should use live.
NEXT_PUBLIC_DATA_MODE=demo
# Catalog 3 is the production catalog; catalog 2 remains a 24-hour publication compatibility target during activation.
NEXT_PUBLIC_CATALOG_VERSION=3
NEXT_PUBLIC_SNAPSHOT_URL=
# Fixed HTTPS origin used by the public health verifier for committed catalog assets.
TRAVELCANARY_PUBLIC_ORIGIN=https://travelcanary.org

# Server-only production values.
# Catalog activation uses revision fencing and compare-and-swap; workers do not need a drain gate.
INGESTION_PAUSED=false
# Comma-separated existing adapter IDs; stopped transports retain aging evidence.
INGESTION_DISABLED_SOURCES=
CRON_SECRET=
PRIVATE_INGESTION_BLOB_READ_WRITE_TOKEN=
PUBLIC_SNAPSHOT_BLOB_READ_WRITE_TOKEN=
FIRMS_MAP_KEY=
# Optional credential-gated Met Office transport. Both values are server-only and neither contributes coverage in this release.
MET_OFFICE_WARNINGS_FEED_URL=
MET_OFFICE_API_KEY=
# Optional authenticated MeteoAlarm recovery for the reviewed Andorra and Iceland mappings only.
METEOALARM_API_TOKEN=
# NRW remains credential-gated and does not run without both values.
NRW_FLOOD_API_BASE_URL=
NRW_FLOOD_API_KEY=
# Keep true in steady-state Production; unset or false is the GFM kill switch.
GFM_ENABLED=true
# Adds GloFAS forecast targeting to GFM; it never publishes forecast-only incidents.
GLOFAS_TARGETING_ENABLED=true
# Adds verified EFFIS perimeters around fresh active-fire detections.
EFFIS_PERIMETERS_ENABLED=true
# Uses Alert Hub only after the corresponding MeteoAlarm country feed fails.
IFRC_FALLBACK_ENABLED=true
# Reliability-gated: keep false until bounded live checks and article timestamps pass the documented activation gate.
GDELT_ENABLED=false
# Enables EONET, EDO, and FCDO context. Unset or false is the shared kill switch.
CONTEXT_FEEDS_ENABLED=true
# Comma-separated uppercase ISO denylist for approved national transports only.
NATIONAL_ALERTS_DISABLED_COUNTRIES=
# Individual national coverage or direct weather-recovery rollback (comma-separated IDs).
# Includes lvgmc-flood,aemet-cap,dhmz-cap,dwd-cap,meteoalarm-edr,met-norway-alerts,nve-flood,ea-flood,met-office-nswws.
# Empty enables approved transports; credential-gated transports remain disabled without their keys.
NATIONAL_ALERTS_DISABLED_TRANSPORTS=
# Reserved for the credential-gated Slovak integration; both remain inert until every manifest gate and the typed adapter are approved.
NATIONAL_ALERT_SK_ENABLED=false
SK_CRISIS_API_KEY=
